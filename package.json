{
  "name": "fat-loss-admin",
  "private": true,
  "version": "1.0.0",
  "description": "个人 AI 减脂管理后台 — 饮食 / 运动 / 体重 / 能量缺口 / AI 顾问",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "preview": "npm run preview -w web",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "reset:db": "npm run reset:db -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20.11"
  }
}
